    name: "FirstFeatureLanding";
    properties: null;
    view: {
        name?: "FirstFeatureLanding";
    };
} | {
    type: "view";
    name: "SecondFeatureLanding";
    properties: null;
    view: {
        name?: "SecondFeatureLanding";
    };
} | {
    type: "track";
    name: "SkipValueProp";
    properties: {
        title: string;
    };
    view: {
        name?: "ValueProposition";
    };
} | {
    type: "track";
    name: "LoginInitiated";
    properties: {
        provider: login_provider;
    };
    view: {
        name?: "Login";
    };
} | {
    type: "track";
    name: "LoginFailed";
    properties: {
        provider: login_provider;
        reason?: string;
    };
    view: {
        name?: "Login";
    };
} | {
    type: "track";
    name: "LoginSuccess";
    properties: {
        provider: login_provider;
    };
    view: {
        name?: "Login";
    };
} | {
    type: "track";
    name: "UserProfileCompleted";
    properties: null;
    view: {
        name?: "UserProfile";
    };
} | {
    type: "track";
    name: "CompanyProfileCompleted";
    properties: {
        hasAddress?: boolean;
        companyType: "llc" | "corporation";
        sectors: Sector[];
    };
    view: {
        name?: "CompanyProfile";
    };
}) & {
    view: {
        url?: string;
    } & Partial<ViewAttributes>;
    source: {
        widget?: string;
        element?: string;
        action?: string;
        view?: ViewNames;
        url?: string;
    };
};
/**
 * What the generated SDK calls to deliver each Event */
export type Implementation = (event: AnalyticsEvent) => void | Promise<void>;
