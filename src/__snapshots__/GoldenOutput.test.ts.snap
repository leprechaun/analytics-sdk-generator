export type login_provider = "auth0" | "facebook" | "apple";
/**
 * Facts about Views, declared in the Tracking Plan */
export type ViewAttributes = {
    section?: "onboarding" | "account";
};
/**
 * Every View's View attributes */
export const viewAttributes: Record<ViewNames, ViewAttributes> = { Splash: {}, ValueProposition: { section: "onboarding" }, Login: { section: "onboarding" }, UserProfile: { section: "account" }, CompanyProfile: { section: "account" }, FirstFeatureLanding: {}, SecondFeatureLanding: {} };
/**
 * The Event each helper hands to the Implementation. Optional fields are for the Implementation to complete */
export type AnalyticsEvent = ({
    type: "view";
    name: "Splash";
    properties: null;
    view: {
        name?: "Splash";
    };
} | {
    type: "view";
    name: "ValueProposition";
    properties: {
        title: string;
    };
    view: {
        name?: "ValueProposition";
    };
} | {
    type: "view";
